# ==============================================================================
# Azal AI - Environment Variables Template
# Copy this file to .env and customize as needed.
# ==============================================================================

# LLM Providers Configuration (Leave empty to use Local LM Studio / Ollama offline)
ACTIVE_LLM_PROVIDER=lmstudio
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=gemma-4-e2b-it

# Cloud Providers (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Server Settings
PORT=8000
HOST=127.0.0.1

# Optional Azure Services (Only needed if using Azure AI Foundry / Search)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
# AZURE_AI_ENDPOINT=https://your-foundry.services.ai.azure.com
# AZAL_INDEX_NAME=azal-index
